    "dev": "tsc && node dist/server.js",
    "test": "tsc && node dist/test-client.js",
    "test:postgres": "DATABASE_URL=postgresql://localhost:5432/entityts_db DB_PROVIDER=postgres tsc && DATABASE_URL=postgresql://localhost:5432/entityts_db DB_PROVIDER=postgres node dist/test-client.js"
  }
}
